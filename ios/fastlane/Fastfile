platform :ios do
  desc "Build iOS archive"
  lane :build do
    gym(
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios",
      output_name: "Runner.ipa"
    )
  end

  desc "Deploy iOS build to App Store"
  lane :deploy do
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      apple_id: ENV['APPLE_ID'],
      app_version: "1.7.0"
    )
  end
end
