default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to TestFlight"
  lane :beta do
    sync_code_signing(type: "appstore") # Ensure code signing is correct
    build_app(scheme: "Runner")

    api_key = app_store_connect_api_key(
      key_id: "Q72Q6X565Z",
      issuer_id: "7abb20de-99b1-49a2-a6c8-66cb6d80e85a",
      key_content: File.read("/Users/intileotechnologies/Documents/Aman/opd_sure_app/ios/fastlane/AuthKey_Q72Q6X565Z.p8").strip,
      in_house: false
    )

    upload_to_testflight(api_key: api_key)

    slack(message: "Successfully distributed a new beta build")
  end
end
