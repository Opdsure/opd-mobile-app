default_platform(:ios)

platform :ios do
  desc "Release app to App Store"
  lane :release do
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )
    upload_to_app_store
  end

  desc "Release app to beta"
  lane :beta do
      sh "export PATH=$HOME/.rbenv/shims:$PATH"
      sh "export PATH=$HOME/.gem/bin:$PATH"
      sh "which pod" # Debugging: check if pod is found
      sh "pod install --repo-update || bundle exec pod install --repo-update"

#     sh "rm -rf ~/Library/Developer/Xcode/DerivedData"
#     sh "rm -rf ios/Pods ios/Podfile.lock"
#     sh "pod install --repo-update"

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )

    upload_to_testflight  # Add this if uploading to TestFlight
  end
end
