# App identity for Fastlane.
#
# Identifiers are read from environment variables in CI (set from GitHub
# secrets / workflow env) and fall back to the project's known values for
# local runs. NO API key id/issuer/path is stored here anymore — the App Store
# Connect API key is loaded at runtime in the Fastfile from a decoded,
# temporary .p8 file (see the `beta` lane). Never commit credentials.

app_identifier(ENV["IOS_BUNDLE_ID"] || "io.app.opdsure")
apple_id(ENV["APPLE_ID"])            # optional; not required for API-key auth
team_id(ENV["APPLE_TEAM_ID"] || "X8JCSQZDGC")
