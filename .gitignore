# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# pubspec.lock IS committed on purpose: this is an application (not a library),
# so the lockfile must be tracked to give CI reproducible dependency versions.
# Without it, CI resolves newer plugins from pub.dev that can require an
# Android SDK platform the runner cannot install (e.g. a non-existent
# platforms;android-37), breaking the release build unexpectedly.
# /pubspec.lock
/lib/test.json
/lib/test.dart
# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ─── Signing & credentials (NEVER COMMIT) ──────────────────────────────────
# Android signing keystores and key configuration
**/*.jks
**/*.keystore
**/key.properties
android/key.properties

# Google Play service-account credentials (Play Developer API)
**/playstore-credentials.json
**/play-store-*.json
**/play_store_*.json
android/fastlane/*.json
# Generic service-account / Google credentials
**/service-account*.json
**/gcp-*.json
google-services-account*.json

# Fastlane runtime/report output
android/fastlane/report.xml
android/fastlane/README.md
**/fastlane/*.log
