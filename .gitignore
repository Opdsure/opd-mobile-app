# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing material and store credentials — never commit these.
# CI writes them from GitHub secrets; see .github/DEPLOY.md.
*.jks
*.keystore
**/key.properties
/android/playstore-credentials.json
/android/fastlane/*.json
**/AuthKey_*.p8
*.p8
*.p12
*.mobileprovision
/ios/fastlane/.env
/ios/fastlane/api_key.json
/ios/ExportOptions-*-configured.plist
